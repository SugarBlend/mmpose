# Volumes paths for specific OS
# Ubuntu
MLFLOW_DATA_PATH=/ssd/mlflow
LS_ML_DATA_PATH=/ssd/auto_ml_backend/models
LS_DATA_PATH=/ssd/labelstudio
LS_DATA_PATH_RESERVE=/ssd/labelstudio_reserve
MINIO_DATA_PATH=/ssd/minio

# Windows
#MLFLOW_DATA_PATH=./data/mlflow
#LS_ML_DATA_PATH=./ml-backend/models
#LS_DATA_PATH=./data/labelstudio
#LS_DATA_PATH_RESERVE=./data/labelstudio_reserve
#MINIO_DATA_PATH=./data/minio

# S3 MinIO
# service credentials for working with object storage
MINIO_GLOBAL_HOST=localhost
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_DEFAULT_BUCKET=datasets
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Label Studio
# service credentials for working with annotations
LABEL_STUDIO_USERNAME=
LABEL_STUDIO_PASSWORD=

# Auth, link and access token for main service
#LABEL_STUDIO_URL="http://labelstudio:8081"
## personal token for retrieving a completed annotation
#LABEL_STUDIO_API_KEY=

# Auth, link and access toekn for reserve service
LABEL_STUDIO_URL="http://labelstudio-reserve:8083"
# personal token for retrieving a completed annotation
LABEL_STUDIO_API_KEY=

BASIC_AUTH_USER=
BASIC_AUTH_PASS=
LABELSTUDIO_PORT=8081
LABELSTUDIO_RESERVE_PORT=8083

